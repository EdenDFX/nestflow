# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (shared NestByEden project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional server-only privileged key (not required for M1 login)
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 (NestFlow attachments) — ADR-004
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=nestflow-attachments
R2_ENDPOINT=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@nestbyeden.com

# Cron protection (Vercel Cron Authorization: Bearer <secret>)
CRON_SECRET=

# Sentry (optional until staging/production)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_ENABLE_DEV=1
